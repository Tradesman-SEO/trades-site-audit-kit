{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trades Site Audit Kit example structure",
  "description": "Structural guide to the supplied example. Runtime validation enforces supported states, publication gates and cross-field rules.",
  "type": "object",
  "properties": {
    "site": {
      "type": "string"
    },
    "baseUrl": {
      "type": "string"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "html": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "html"
        ]
      }
    }
  },
  "required": [
    "site",
    "baseUrl",
    "pages"
  ]
}
